
PHISHGUARD_HOST=127.0.0.1
PHISHGUARD_PORT=3399
PHISHGUARD_DEBUG=false

# Generate a unique random API key (minimum 32 characters)
PHISHGUARD_API_KEY=replace-with-a-long-random-secret

# Admin panel password (minimum 16 characters)
# Set your real password privately in your local .env file.
# Never commit your real password to GitHub.
PHISHGUARD_ADMIN_PASSWORD=replace-with-a-unique-strong-password

# Comma-separated domains that you own and are authorized to test
PHISHGUARD_ALLOWED_WEBSITE_DOMAINS=your-owned-domain.com
